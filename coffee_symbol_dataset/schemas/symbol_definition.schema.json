{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/symbol_definition.schema.json",
  "title": "Atlas SymbolDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "symbolId",
    "revision",
    "canonicalJsonProfileRef",
    "preferredNames",
    "neutralDefinitions"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "recordType": {"const": "atlas.symbolDefinition"},
    "symbolId": {"$ref": "#/$defs/identifier"},
    "revision": {"$ref": "#/$defs/revision"},
    "canonicalJsonProfileRef": {"$ref": "#/$defs/profileRef"},
    "preferredNames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourcedLocalizedText"}
    },
    "aliases": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourcedLocalizedText"}
    },
    "neutralDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourcedLocalizedText"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "revision": {"type": "integer", "minimum": 1},
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "revision", "checksum"],
      "properties": {
        "profileId": {"const": "atlas-canonical-json"},
        "revision": {"const": 1},
        "checksum": {
          "const": "sha256:16e9e10eb848828a863a7eca1c0b7e7c84e1a485065d00f938c6af356cd54ad7"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "revision"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/identifier"},
        "revision": {"$ref": "#/$defs/revision"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "sourcedLocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "value", "sourceRefs"],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "value": {"type": "string", "minLength": 1},
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        }
      }
    }
  }
}
